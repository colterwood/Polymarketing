# Polymarket users to monitor (comma-separated usernames)
POLYMARKET_USERS=magamyman,whopperlover

# Local database file
DB_PATH=data/polymarket.db

# Polymarket session cookie (required — gamma-api.polymarket.com now requires auth)
# Get it from Chrome DevTools: log into polymarket.com, open Network tab, click any
# request to gamma-api.polymarket.com, copy the full "cookie:" request header value.
POLYMARKET_COOKIE=

# Twilio credentials (Phase 2)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
ALERT_TO_NUMBER=

# Alert threshold: 0..1, send SMS when a new bet's size is at or above this percentile.
# Placeholder until Phase 1 analysis tells us what the distribution looks like.
ALERT_PERCENTILE=0.90

# Poll cadence (cron expression). Default: every 30 minutes.
POLL_CRON=*/30 * * * *

# HTTP client tuning
HTTP_MAX_RETRIES=5
HTTP_RPS_LIMIT=5

# Set to "true" to skip sending SMS and just log the alert (useful for first runs)
DRY_RUN=false

# Log level: trace | debug | info | warn | error
LOG_LEVEL=info
