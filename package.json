{
  "name": "polymarketing",
  "version": "0.1.0",
  "description": "Polymarket bet tracker: scrape user histories, analyze, alert on outlier bets.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "backfill": "tsx src/cli/backfill.ts",
    "analyze": "tsx src/cli/analyze.ts",
    "start": "tsx src/cli/start.ts",
    "watch": "tsx src/cli/watch.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "better-sqlite3": "^11.3.0",
    "dotenv": "^16.4.5",
    "node-cron": "^3.0.3",
    "pino": "^9.5.0",
    "pino-pretty": "^11.3.0",
    "simple-statistics": "^7.8.3",
    "twilio": "^5.3.5",
    "viem": "^2.51.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^22.7.5",
    "@types/node-cron": "^3.0.11",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2",
    "vitest": "^2.1.2"
  }
}
